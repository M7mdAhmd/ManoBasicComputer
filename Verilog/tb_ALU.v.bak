`timescale 1ns/1ps
module tb_ALU;
    reg [15:0] a, b;
    reg e_in;
    reg [2:0] op;
    wire [15:0] result;
    wire e_out, zero_flag, sign_flag;
    ALU uut (.a(a), .b(b), .e_in(e_in), .op(op), .result(result), .e_out(e_out), .zero_flag(zero_flag), .sign_flag(sign_flag));
    initial begin
        a = 16'h000F; b = 16'h0001; e_in = 0;
        op = 3'b000; #10;
        op = 3'b001; #10;
        op = 3'b010; #10;
        op = 3'b011; #10;
        op = 3'b100; #10;
        op = 3'b101; #10;
        op = 3'b110; #10;
        op = 3'b111; #10;
        $stop;
    end
endmodule