module tb_InstructionRegister;
    reg clk, load;
    reg [15:0] instruction_in;
    wire [15:0] instruction_out;

    InstructionRegister uut(.clk(clk), .load(load), .instruction_in(instruction_in), .instruction_out(instruction_out));

    initial begin
        clk = 0;
        forever #5 clk = ~clk;
    end

    initial begin
        load = 0; instruction_in = 16'h1234;
        #10 load = 1;
        #10 instruction_in = 16'h5678;
        #10 load = 0;
        #20 $finish;
    end
endmodule
