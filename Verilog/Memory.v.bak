module Memory(
    input clk,
    input read,
    input write,
    input [11:0] address,
    input [15:0] data_in,
    output reg [15:0] data_out
);
    reg [15:0] mem [0:4095]; // 4K memory

    // Optional: preload some instructions
    initial begin
        mem[0] = 16'b0111000000000000; // example instruction (opcode 111)
        mem[1] = 16'b0001000100010001;
    end

    always @(posedge clk) begin
        if (read)
            data_out <= mem[address];
        if (write)
            mem[address] <= data_in;
    end
endmodule

